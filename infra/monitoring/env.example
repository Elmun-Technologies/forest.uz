# Monitoring host env (copy to infra/monitoring/.env on the monitoring VPS; never commit it).
# Generate secrets on the server, e.g.:  openssl rand -hex 32
GLITCHTIP_DOMAIN=glitchtip.example.uz
KUMA_DOMAIN=status.example.uz
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=
# SMTP for GlitchTip alert e-mails (optional): smtp://user:pass@host:587
GLITCHTIP_EMAIL_URL=
GLITCHTIP_FROM_EMAIL=
# Optional: office/VPN CIDRs for the Kuma UI (space separated)
KUMA_ALLOWLIST=
