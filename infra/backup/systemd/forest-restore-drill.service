[Unit]
Description=Forest monthly restore drill from the offsite dump
Documentation=file:///opt/forest/app/docs/runbooks/restore-db.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=FOREST_ROOT=/opt/forest/app
Environment=BACKUP_DIR=/var/backups/forest
ExecStart=/opt/forest/app/infra/backup/restore-drill.sh --from-remote
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
