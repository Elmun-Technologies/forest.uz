# Ops-only secrets on the VPS: copy to /opt/forest/app/.env.ops (chmod 600; git-ignored, never in
# an image). Read by infra/backup/*.sh and deploy.sh; postgres gets only the PGBACKREST_* values.
# Generate secrets on the server (openssl rand -base64 48) and keep a copy of both passphrases
# OUTSIDE the server (password manager): without them the backups cannot be decrypted.

# Telegram admin alerts group (ops failures: backups, drills, deploys). Bot token of the shop bot
# (Admin → Integrations → Telegram) and the group's chat id.
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=

# Uptime Kuma push monitors (one per job; docs/runbooks/monitoring.md)
OPS_HEARTBEAT_URL_BACKUP_DB=
OPS_HEARTBEAT_URL_PGBACKREST=
OPS_HEARTBEAT_URL_BACKUP_OBJECTS=
OPS_HEARTBEAT_URL_RESTORE_DRILL=

# Backup bucket in Uzbekistan (S3-compatible) — dumps, objects (rclone crypt)
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=forest-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_REMOTE_DAYS=30
BACKUP_LOCAL_DAYS=7
# Live buckets as seen by the backup job: compose SeaweedFS → http://storage:8333 + network
# forest_egress; a UZ S3 provider → leave empty (S3_ENDPOINT from .env is used).
S3_ENDPOINT_FOR_BACKUP=http://storage:8333
RCLONE_NETWORK=forest_egress

# pgBackRest repository (same bucket, prefix /pgbackrest; AES-256 repository encryption).
# ENDPOINT is the host name only (no https://), TLS is verified.
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_BUCKET=forest-backups
PGBACKREST_REPO1_S3_REGION=us-east-1
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_CIPHER_PASS=
