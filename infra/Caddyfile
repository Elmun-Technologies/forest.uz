# Client IP: requests from TRUSTED_PROXIES (set it to Cloudflare's published IP ranges when
# Cloudflare is in front) keep their X-Forwarded-For and Caddy appends the edge address; anything
# else gets its XFF replaced by the real peer. Pair with the API's TRUST_PROXY_HOPS (1 without
# Cloudflare, 2 with it) — see docs/runbooks/deploy-network.md.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

# TLS is automatic (Let's Encrypt) when the domains resolve to this host. Cloudflare sits in front
# in production: HTML/API with personal data must never be cached there (docs/14).
{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
	}
	# Only the API calls it, over the internal network (signed anyway; CLAUDE.md §6).
	respond /api/revalidate 404
	reverse_proxy web:3000
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
	reverse_proxy admin:3001
}

{$API_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
	}
	reverse_proxy api:4000
}
