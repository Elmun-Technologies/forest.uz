  },
  "devDependencies": {
    "@forest/config": "workspace:*",
    "@forest/contracts": "workspace:*",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "jsdom": "^27.4.0",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
