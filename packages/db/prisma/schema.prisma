// Forest — initial data model (draft v1).
// Move to packages/db/prisma/schema.prisma. Claude Code may refine, but must keep the
// invariants documented in docs/04-data-model.md and docs/02-business-rules.md.
// Money = BigInt tiyin (1 so'm = 100 tiyin). Localized text = Json { "uz": string, "ru": string }.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Locale {
  uz
  ru
}

enum ProductType {
  SIMPLE
  BUNDLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKING
  READY
  HANDED_TO_COURIER
  DELIVERED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentMethod {
  PAYME
  CLICK
  COD
}

enum PaymentStatus {
  PENDING
  COD_PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DeliveryCarrier {
  YANDEX
  BTS
  PICKUP
}

enum DeliveryStatus {
  NOT_CREATED
  CREATED
  COURIER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  AT_BRANCH
  DELIVERED
  FAILED
  RETURNED
}

enum ActorType {
  CUSTOMER
  STAFF
  SYSTEM
  CARRIER
  PAYMENT_PROVIDER
  BOT
}

enum StaffRole {
  OWNER
  MANAGER
  OPERATOR
  WAREHOUSE
  MARKETER
}

enum PromoType {
  PERCENT
  FIXED
  FREE_SHIPPING
  GIFT
}

enum PromoAudience {
  ALL
  FIRST_ORDER
  SEGMENT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsentChannel {
  SMS_MARKETING
  TELEGRAM
  ADS_MATCHING
  ANALYTICS_COOKIES
}

enum MessageChannel {
  TELEGRAM
  SMS
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED_CAP
  SKIPPED_NO_CONSENT
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  COMING_SOON
}

enum ConversationStatus {
  NEW
  OPEN
  ANSWERED
  COMPLAINT
  CLOSED
}

// ───────────────────────── Marketplace-ready seller ─────────────────────────

model Seller {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  isOfficial     Boolean    @default(false)
  commissionBps  Int? // v2: basis points
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  products       Product[]
  shipments      Shipment[]
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      Json // {uz, ru}
  seoText   Json? // {uz, ru} rich text block under catalog
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sort      Int        @default(0)
  products  ProductCategory[]
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique
  type          ProductType   @default(SIMPLE)
  status        ProductStatus @default(DRAFT)
  sellerId      String
  seller        Seller        @relation(fields: [sellerId], references: [id])
  name          Json // {uz, ru}
  shortDesc     Json?
  description   Json? // rich text per locale
  howToApply    Json?
  specs         Json? // [{key:{uz,ru}, value:{uz,ru}}]
  badges        String[] // HIT, NEW, SALE
  coverageM2PerL Decimal?     @db.Decimal(5, 2) // for calculator
  dryTimeMinutes Int?
  isBestseller  Boolean       @default(false)
  bestsellerSort Int?
  moyskladId    String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  variants      Variant[]
  images        ProductImage[]
  categories    ProductCategory[]
  reviews       Review[]
  bundleItems   BundleItem[]  @relation("BundleParent")
  related       ProductRelation[] @relation("RelFrom")
  relatedTo     ProductRelation[] @relation("RelTo")
  waitlist      WaitlistEntry[]

  @@index([status, sellerId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductRelation {
  fromId String
  toId   String
  kind   String // CROSS_SELL | UPSELL | ALTERNATIVE
  sort   Int    @default(0)
  from   Product @relation("RelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Product @relation("RelTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId, kind])
}

model Variant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String   @unique
  label           Json // {uz:"1 L", ru:"1 л"} or color name
  colorHex        String?
  volumeMl        Int?
  priceTiyin      BigInt
  compareAtTiyin  BigInt?
  ikpu            String? // MXIK code — required before ACTIVE
  packageCode     String?
  vatPercent      Int      @default(12)
  barcode         String?
  weightGrams     Int?
  stock           Int      @default(0) // from MoySklad (available)
  reserved        Int      @default(0) // our open reservations
  lowStockAt      Int      @default(10)
  moyskladId      String?  @unique
  active          Boolean  @default(true)
  sort            Int      @default(0)
  updatedAt       DateTime @updatedAt
  bundleOf        BundleItem[] @relation("BundleComponent")
  orderItems      OrderItem[]
  cartItems       CartItem[]
}

model BundleItem {
  bundleId    String
  variantId   String
  qty         Int     @default(1)
  bundle      Product @relation("BundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  variant     Variant @relation("BundleComponent", fields: [variantId], references: [id])

  @@id([bundleId, variantId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileId    String
  file      File    @relation(fields: [fileId], references: [id])
  alt       Json?
  isVideo   Boolean @default(false)
  sort      Int     @default(0)
}

model WaitlistEntry {
  id         String    @id @default(cuid())
  productId  String
  variantId  String?
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  phone      String?
  channel    MessageChannel
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ───────────────────────── Customers & CRM ─────────────────────────

model Customer {
  id            String    @id @default(cuid())
  publicId      String    @unique // C-10482
  phone         String    @unique // E.164
  name          String?
  locale        Locale    @default(uz)
  telegramId    BigInt?   @unique
  telegramUsername String?
  tags          String[]
  firstSeenAt   DateTime  @default(now())
  firstTouch    Json? // {source, medium, campaign, content, term, clickId, landing, ts}
  lastTouch     Json?
  ordersCount   Int       @default(0)
  ltvTiyin      BigInt    @default(0)
  lastOrderAt   DateTime?
  deletedAt     DateTime? // erasure request processed
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  addresses     Address[]
  orders        Order[]
  consents      Consent[]
  visitors      Visitor[]
  reviews       Review[]
  carts         Cart[]
  messages      Message[]
  conversations Conversation[]
  favorites     Favorite[]
  notes         CustomerNote[]
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  region     String
  district   String?
  line       String
  lat        Decimal? @db.Decimal(9, 6)
  lng        Decimal? @db.Decimal(9, 6)
  isDefault  Boolean  @default(false)
}

model Consent {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    ConsentChannel
  granted    Boolean
  source     String // checkout, popup, bot, cabinet
  createdAt  DateTime       @default(now())

  @@index([customerId, channel, createdAt])
}

model Favorite {
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, productId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId    String
  text       String
  createdAt  DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// ───────────────────────── Cart & checkout ─────────────────────────

model Cart {
  id          String     @id @default(cuid())
  anonymousId String?    @unique
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  promoCode   String?
  status      String     @default("ACTIVE") // ACTIVE | CONVERTED | ABANDONED_NOTIFIED
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())
  items       CartItem[]

  @@index([customerId])
  @@index([status, updatedAt])
}

model CartItem {
  cartId    String
  variantId String
  qty       Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   Variant @relation(fields: [variantId], references: [id])
  addedAt   DateTime @default(now())

  @@id([cartId, variantId])
}

// ───────────────────────── Orders ─────────────────────────

model Order {
  id               String        @id @default(cuid())
  number           String        @unique // F-10482
  trackingToken    String        @unique
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id])
  status           OrderStatus   @default(NEW)
  locale           Locale        @default(uz)
  contactName      String
  contactPhone     String
  address          Json // snapshot {region, district, line, lat, lng}
  comment          String?
  subtotalTiyin    BigInt
  discountTiyin    BigInt        @default(0)
  shippingTiyin    BigInt        @default(0)
  totalTiyin       BigInt
  promoCode        String?
  offerVersion     String
  slaDueAt         DateTime? // 12h / 24h promise
  attribution      Json? // {firstTouch, lastTouch, touches[], model results}
  anonymousId      String?
  sessionId        String?
  source           String        @default("web") // web | bot | admin
  cancelReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            OrderItem[]
  payments         Payment[]
  shipments        Shipment[]
  events           OrderEvent[]
  reservations     Reservation[]
  promoRedemption  PromoRedemption?

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant @relation(fields: [variantId], references: [id])
  sellerId     String
  nameSnapshot Json
  sku          String
  ikpu         String
  packageCode  String?
  vatPercent   Int
  qty          Int
  priceTiyin   BigInt
  discountTiyin BigInt @default(0)
}

model OrderEvent {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // STATUS_CHANGED, PAYMENT_*, DELIVERY_*, NOTE, NOTIFICATION_SENT ...
  from      String?
  to        String?
  actorType ActorType
  actorId   String?
  data      Json?
  createdAt DateTime  @default(now())

  @@index([orderId, createdAt])
}

model Reservation {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  qty       Int
  expiresAt DateTime?
  releasedAt DateTime?
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  method          PaymentMethod
  status          PaymentStatus
  amountTiyin     BigInt
  providerTxnId   String? // Payme transaction id / Click click_trans_id
  providerState   Int? // Payme state 1,2,-1,-2
  providerData    Json?
  performedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    Int?
  fiscalReceiptUrl String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  refunds         Refund[]

  @@unique([method, providerTxnId])
  @@index([orderId])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id])
  amountTiyin BigInt
  reason      String
  staffId     String
  createdAt   DateTime @default(now())
}

model Shipment {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         Seller          @relation(fields: [sellerId], references: [id])
  carrier        DeliveryCarrier
  status         DeliveryStatus  @default(NOT_CREATED)
  externalId     String? // Yandex claim id / BTS waybill
  trackNumber    String?
  branch         Json? // BTS branch info
  courier        Json? // name, phone, car, plate, eta
  priceTiyin     BigInt          @default(0)
  history        Json? // carrier tracking history
  updatedAt      DateTime        @updatedAt
}

// ───────────────────────── Promo ─────────────────────────

model PromoCode {
  id              String        @id @default(cuid())
  code            String        @unique
  type            PromoType
  value           Int // percent or tiyin/100 depending on type
  giftVariantId   String?
  minCartTiyin    BigInt        @default(0)
  audience        PromoAudience @default(ALL)
  segmentId       String?
  usageLimit      Int?
  perCustomerLimit Int          @default(1)
  startsAt        DateTime?
  endsAt          DateTime?
  utmSource       String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  redemptions     PromoRedemption[]
}

model PromoRedemption {
  id           String    @id @default(cuid())
  promoId      String
  promo        PromoCode @relation(fields: [promoId], references: [id])
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id])
  customerId   String
  deviceHash   String?
  discountTiyin BigInt
  suspicious   Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([promoId, customerId])
}

// ───────────────────────── Reviews & UGC ─────────────────────────

model Review {
  id           String       @id @default(cuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id])
  orderId      String
  rating       Int
  text         String?
  locale       Locale
  source       String // web | bot
  status       ReviewStatus @default(PENDING)
  photoFileIds String[]
  photoConsent Boolean      @default(false)
  inGallery    Boolean      @default(false)
  gallerySort  Int?
  beforeFileId String?
  reply        String?
  moderatedBy  String?
  createdAt    DateTime     @default(now())

  @@unique([orderId, productId])
  @@index([productId, status])
}

// ───────────────────────── Analytics (first-party) ─────────────────────────

model Visitor {
  anonymousId String    @id // first-party cookie fr_aid
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  firstTouch  Json?
  deviceHash  String?

  @@index([customerId])
}

model Session {
  id           String   @id // uuid from tracker
  anonymousId  String
  customerId   String?
  startedAt    DateTime
  endedAt      DateTime
  landingPath  String
  exitPath     String?
  pageviews    Int      @default(0)
  events       Int      @default(0)
  durationSec  Int      @default(0)
  bounced      Boolean  @default(true)
  utm          Json? // source, medium, campaign, content, term
  clickIds     Json? // fbclid, gclid, ttclid, yclid
  referrer     String?
  channel      String // paid_social, organic_search, telegram, direct, referral, email, sms...
  device       String // mobile | desktop | tablet
  os           String?
  browser      String?
  city         String?
  region       String?
  country      String?
  converted    Boolean  @default(false)
  orderId      String?
  hasReplay    Boolean  @default(false)
  replayKey    String? // object storage prefix

  @@index([startedAt])
  @@index([anonymousId, startedAt])
  @@index([channel, startedAt])
}

// NOTE: high-volume table. Create as PARTITION BY RANGE (ts) monthly via raw SQL migration;
// Prisma model mirrors columns for typed reads. See docs/07-analytics-tracking.md.
model Event {
  id          String   @id // uuid v7, also used as event_id for ad-platform dedupe
  ts          DateTime
  sessionId   String
  anonymousId String
  customerId  String?
  name        String // page_view, view_item, add_to_cart, begin_checkout, purchase, lead, selector_used ...
  path        String
  props       Json?
  // heatmap fields (click events)
  selector    String?
  x           Int? // relative ‰ within element/page width
  y           Int?
  viewportW   Int?
  scrollDepth Int?

  @@index([ts])
  @@index([name, ts])
  @@index([sessionId])
  @@index([path, name])
}

model AdSpendDaily {
  date       DateTime @db.Date
  platform   String // meta | google | tiktok | yandex
  campaignId String
  campaign   String
  adset      String?
  spendTiyin BigInt
  impressions Int
  clicks     Int

  @@id([date, platform, campaignId])
}

model Segment {
  id          String   @id @default(cuid())
  name        String
  rules       Json // rule tree, see docs/08-admin-panel.md A8
  autoMessage Json? // optional automation (template, delay, channel)
  destinations String[] // meta, google, tiktok, yandex, telegram, sms
  size        Int      @default(0)
  refreshedAt DateTime?
  active      Boolean  @default(true)
  members     SegmentMember[]
}

model SegmentMember {
  segmentId  String
  customerId String
  addedAt    DateTime @default(now())
  segment    Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([segmentId, customerId])
}

// ───────────────────────── Messaging & bot ─────────────────────────

model MessageTemplate {
  id        String   @id @default(cuid())
  key       String   @unique // lead_welcome, order_status_shipped, cart_abandoned_2h, review_request ...
  body      Json // {uz, ru} with {ism},{mahsulot},{raqam},{kod},{link},{vaqt}
  buttons   Json?
  delayMin  Int      @default(0)
  smsFallback Boolean @default(true)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Message {
  id          String         @id @default(cuid())
  customerId  String?
  customer    Customer?      @relation(fields: [customerId], references: [id])
  channel     MessageChannel
  templateKey String?
  body        String
  status      MessageStatus  @default(QUEUED)
  marketing   Boolean        @default(false)
  providerId  String?
  error       String?
  createdAt   DateTime       @default(now())
  sentAt      DateTime?

  @@index([customerId, createdAt])
}

model Conversation {
  id         String             @id @default(cuid())
  customerId String?
  customer   Customer?          @relation(fields: [customerId], references: [id])
  telegramChatId BigInt
  topic      String // advice | cart | status | review | other
  status     ConversationStatus @default(NEW)
  assigneeId String?
  lastMessageAt DateTime        @default(now())
  messages   ConversationMessage[]

  @@index([status, lastMessageAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromCustomer   Boolean
  staffId        String?
  text           String?
  fileIds        String[]
  createdAt      DateTime     @default(now())
}

// ───────────────────────── SEO & content ─────────────────────────

model SeoMeta {
  id          String  @id @default(cuid())
  path        String // route pattern or concrete path, e.g. "/", "/p/chalk-white"
  locale      Locale
  title       String
  description String
  ogImageId   String?
  noindex     Boolean @default(false)
  canonical   String?

  @@unique([path, locale])
}

model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique
  to        String
  code      Int      @default(301)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

model NotFoundLog {
  path      String   @id
  hits      Int      @default(1)
  lastSeen  DateTime @default(now())
  referrer  String?
}

model SearchQueryLog {
  id        String   @id @default(cuid())
  query     String
  locale    Locale
  results   Int
  createdAt DateTime @default(now())

  @@index([results, createdAt])
}

model Page {
  id        String   @id @default(cuid())
  kind      String // LEGAL | ARTICLE | FAQ | HOME_BLOCK
  slug      String
  locale    Locale
  title     String
  body      Json // rich text (TipTap JSON)
  version   String?
  published Boolean  @default(false)
  coverId   String?
  updatedAt DateTime @updatedAt

  @@unique([kind, slug, locale])
}

// ───────────────────────── Integrations, settings, staff ─────────────────────────

model Integration {
  key          String            @id // payme, click, yandex, bts, moysklad, eskiz, telegram, meta_capi, google_ads, gsc, ywm ...
  status       IntegrationStatus @default(DISCONNECTED)
  credentials  Bytes? // AES-256-GCM encrypted JSON
  config       Json?
  lastCheckAt  DateTime?
  lastError    String?
  updatedAt    DateTime          @updatedAt
  logs         IntegrationLog[]
}

model IntegrationLog {
  id             String      @id @default(cuid())
  integrationKey String
  integration    Integration @relation(fields: [integrationKey], references: [key])
  direction      String // IN | OUT
  kind           String // e.g. order.push, stock.update, webhook
  ok             Boolean
  message        String
  payload        Json? // redacted
  createdAt      DateTime    @default(now())

  @@index([integrationKey, createdAt])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  url       String
  events    String[] // order.created, order.paid, order.shipped, cart.abandoned, customer.created, stock.low
  secret    String // HMAC-SHA256 signing secret (encrypted at rest)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id // delivery.zones, delivery.cutoff, store.info, legal.offerVersion, flags ...
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Staff {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         StaffRole
  totpSecret   Bytes? // encrypted
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?
  action    String // e.g. order.cancel, integration.update, promo.update, customer.view_pii
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model File {
  id        String   @id @default(cuid())
  key       String   @unique // object storage key
  mime      String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  productImages ProductImage[]
}
