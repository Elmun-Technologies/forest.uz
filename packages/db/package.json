{
  "name": "@forest/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "generated",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:diff": "prisma migrate diff",
    "seed": "dotenv -e ../../.env -- tsx src/seed/index.ts",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "test": "echo 'db: covered by api integration tests'",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.917.0",
    "@forest/config": "workspace:*",
    "@forest/contracts": "workspace:*",
    "@types/node": "^22.18.0",
    "argon2": "^0.44.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.0",
    "prisma": "6.19.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
