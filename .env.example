# Forest — environment template. Copy to .env. NEVER commit real values.
# NODE_ENV is intentionally not set here: each command sets it (next build → production, dev → development).
# Integration credentials (Payme, Click, MoySklad, Yandex, BTS, Eskiz, Meta, Google...) are
# entered in Admin → Integrations and stored encrypted in the DB, not here.

APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
# Storefront as reached from api/admin servers (revalidation, A3 heatmap backdrop); default APP_URL.
# WEB_INTERNAL_URL=http://web:3000

# Database / cache / storage
DATABASE_URL=postgresql://forest:forest@localhost:5432/forest
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Path-style addressing (SeaweedFS/MinIO). Tigris (Fly demo) needs false = virtual-hosted.
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=forest-public
S3_BUCKET_PRIVATE=forest-private
S3_ACCESS_KEY=forest-dev
S3_SECRET_KEY=forest-dev-secret
# Public base URL for files in the public bucket (CDN URL in production)
S3_PUBLIC_URL=http://localhost:9000/forest-public

# Security
APP_ENCRYPTION_KEY=generate-32-byte-base64-key   # openssl rand -base64 32
SESSION_SECRET=generate-long-random-string
# Signs API ↔ storefront server calls (on-demand revalidation, 404 reports); same value for api and
# web, ≥ 32 chars (openssl rand -hex 32). Required in production (missing = those calls are refused).
WEB_REVALIDATE_SECRET=generate-long-random-string
ADMIN_COOKIE_DOMAIN=localhost

# Bootstrap owner account (first run only; change password + enable 2FA after login)
OWNER_EMAIL=owner@example.com
OWNER_INITIAL_PASSWORD=change-me-on-first-login

# Telegram (bot token can also be set in admin; env value used for bootstrap)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=generate-random
TELEGRAM_ADMIN_CHAT_ID=

# Providers mode: fake | sandbox | live  (fake = no external calls)
PROVIDERS_MODE=fake
# Local only: dev endpoints (fake SMS/Telegram outbox, fake shipment, admin TOTP for e2e). Never in
# production. Everything except the narrow OTP lookup `GET /v1/dev/outbox?to=<phone>` needs the
# header X-Dev-Token = DEV_ENDPOINTS_TOKEN (pnpm dev generates it; required with NODE_ENV=production).
DEV_ENDPOINTS=true
DEV_ENDPOINTS_TOKEN=
# POST /v1/dev/admin-totp with NODE_ENV=production (CI e2e only — never on a public demo).
ALLOW_DEV_ADMIN_TOTP=false
# Allow fake providers with NODE_ENV=production (demos/CI only).
ALLOW_FAKE_PROVIDERS=false

# Observability
# GlitchTip (self-hosted, Sentry protocol) DSN for api, web and admin servers; empty = off.
SENTRY_DSN=
LOG_LEVEL=info

# GeoIP database path (DB-IP Lite or MaxMind GeoLite2 .mmdb)
GEOIP_DB_PATH=./data/geoip.mmdb

# AI drafts (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Client IP behind proxies (rate limits). 1 = Caddy only; 2 = Cloudflare → Caddy (then also set
# TRUSTED_PROXIES to Cloudflare's IP ranges: https://www.cloudflare.com/ips/).
TRUST_PROXY_HOPS=1
TRUSTED_PROXIES=private_ranges
# Demo on Vercel → Fly only (no Caddy): shared secret the web/admin middleware sends as X-Forest-Edge
# on /api/*; the API trusts X-Forwarded-For only on requests carrying it. Leave empty with Caddy.
EDGE_PROXY_SECRET=

# ── Production VPS only (infra/deploy/deploy.sh, docs/launch-checklist.md) ──
# Postgres owner password (migrations/seed) and the API's own role (infra/deploy/db-roles.sql).
POSTGRES_PASSWORD=
FOREST_APP_DB_PASSWORD=
# Optional read-only role for support queries (empty = forest_ro cannot log in).
FOREST_RO_DB_PASSWORD=
# Caddy site names (TLS via Let's Encrypt) and the optional public-bucket site.
SITE_DOMAIN=
ADMIN_DOMAIN=
API_DOMAIN=
CDN_DOMAIN=
# Optional: CIDRs allowed to open the admin (space separated); default everyone.
ADMIN_ALLOWLIST=
# Optional CSP report sink, e.g. "; report-uri https://<glitchtip>/api/<id>/security/?sentry_key=<key>"
CSP_REPORT=
# Storefront containers behind Caddy (one Node process uses one core).
WEB_REPLICAS=2
